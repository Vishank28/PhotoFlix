# Copy to ".env". Leave PF_BUCKET empty to keep everything in the local data/ folder.
# AWS login comes from "aws configure" on this PC (or the IAM role on EC2), not from this file.
AWS_REGION=us-east-1
PF_BUCKET=your-s3-bucket-name
# Screens + patient list in DynamoDB (photos stay in S3). Leave empty to keep them as files.
# Table: partition key "pk" (String), sort key "sk" (String), on-demand; turn on TTL with attribute "expiresAt".
PF_TABLE=
PF_TABLE_PK=pk
PF_TABLE_SK=sk
# Fixed public address (optional). Without it, a free Cloudflare link is opened automatically.
# PUBLIC_URL=https://screens.yourdomain.com
# Patient queue in AWS Lambda (DynamoDB). Leave empty to keep the queue in this server.
PF_LAMBDA=
